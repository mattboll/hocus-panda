Icon=preferences-system
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=settings;preferences;configuration;power;sleep;réglages;préférences;énergie;veille;
OnlyShowIn=Hocuspanda;
StartupNotify=true
StartupWMClass=hocus-settings
