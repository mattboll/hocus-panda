+/// Whether every frame draws the whole window (Hocuspanda's patch, #662).
+static WHOLE_FRAMES: AtomicBool = AtomicBool::new(false);
+
+/// Makes every frame presented from now on draw the whole window, instead
+/// of the regions found changed since the buffer's last frame.
+///
+/// Hocuspanda's patch (#662): the regions found changed miss what a
+/// primitive draws past its bounds (a shadow, an anti-aliased stroke, text
+/// moved with its layer, a gradient drawn in pieces, an overlay closed),
+/// which stays on screen. A program that draws only when something
+/// changed pays one whole frame per change for none of that.
+pub fn draw_whole_frames(whole: bool) {
+    WHOLE_FRAMES.store(whole, Ordering::Relaxed);
+}
 
